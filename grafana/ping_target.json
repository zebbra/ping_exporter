    {
      "type": "stat",
      "title": "RTT",
      "id": 11,
      "description": "Best, mean and worst RTT of the last probe.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "min(probe_ping_rtt_seconds{job=\"$job\", instance=\"$target\", type=\"best\"})",
          "legendFormat": "Min",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "avg(probe_ping_rtt_seconds{job=\"$job\", instance=\"$target\", type=\"mean\"})",
          "legendFormat": "Avg",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max(probe_ping_rtt_seconds{job=\"$job\", instance=\"$target\", type=\"worst\"})",
          "legendFormat": "Max",
          "refId": "C",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
